# Copy to .env.local and fill in from your Supabase project → Project Settings → API.
# These are PUBLIC values (safe in a client bundle). RLS protects the data.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Where the landing page's "Download Now" button sends people to install the
# browser extension. Set this to the published Chrome Web Store listing once it
# exists. Optional — defaults to the Chrome Web Store home.
VITE_EXTENSION_URL=https://chromewebstore.google.com/detail/your-extension-id
