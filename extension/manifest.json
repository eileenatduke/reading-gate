{
  "manifest_version": 3,
  "name": "Reading Gate",
  "version": "0.11.0",
  "description": "Read and summarize a news article before a distracting site unlocks. Every open, a fresh article.",
  "permissions": ["tabs", "storage", "alarms", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Reading Gate"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
